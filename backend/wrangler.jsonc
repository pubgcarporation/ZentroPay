{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zentropay-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zentropay",
      // Run `wrangler d1 create zentropay` and paste the returned id here.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    // Comma-separated frontend origins allowed to call the API, e.g. "https://zentropay.vercel.app".
    "ALLOWED_ORIGINS": "*",
    "ARC_RPC_URL": "https://rpc.testnet.arc.io",
    "USDC_ADDRESS": "0x3600000000000000000000000000000000000000",
    "EXPLORER_URL": "https://explorer.testnet.arc.io"
  }
}
